{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "loginctl hibernate || systemctl hibernate",
    "text" : "save",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "pkill Hyprland || pkill sway || pkill niri || loginctl terminate-user $USER",
    "text" : "logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "loginctl poweroff || systemctl poweroff",
    "text" : "power_settings_new",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "loginctl suspend || systemctl suspend",
    "text" : "bedtime",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "loginctl reboot || systemctl reboot",
    "text" : "restart_alt",
    "keybind" : "r"
}
