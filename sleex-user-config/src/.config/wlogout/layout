{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "/usr/share/sleex/scripts/power-action.sh hibernate",
    "text" : "save",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "pkill Hyprland || pkill sway || pkill niri || loginctl terminate-user $USER",
    "text" : "logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "/usr/share/sleex/scripts/power-action.sh poweroff",
    "text" : "power_settings_new",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "/usr/share/sleex/scripts/power-action.sh suspend",
    "text" : "bedtime",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "/usr/share/sleex/scripts/power-action.sh reboot",
    "text" : "restart_alt",
    "keybind" : "r"
}
